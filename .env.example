# Local infrastructure defaults. Copy to .env and replace values for your environment.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=novacommerce
POSTGRES_USER=novacommerce
POSTGRES_PASSWORD=change-me

# Auth service database (a separate logical database in local PostgreSQL)
AUTH_DB_URL=jdbc:postgresql://localhost:5432/novacommerce_auth
AUTH_DB_USERNAME=novacommerce
AUTH_DB_PASSWORD=change-me

# JWT keys: generate local files with scripts/generate-dev-auth-keys.ps1
AUTH_JWT_PRIVATE_KEY_PATH=.local/keys/auth-private.pem
AUTH_JWT_PUBLIC_KEY_PATH=.local/keys/auth-public.pem
AUTH_JWT_ISSUER=novacommerce-auth
AUTH_JWT_AUDIENCE=novacommerce-api
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P7D

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_ALLOWED_ORIGINS=http://localhost:3000

# Catalog service database and cross-service authentication
CATALOG_DB_URL=jdbc:postgresql://localhost:5432/novacommerce_catalog
CATALOG_DB_USERNAME=novacommerce
CATALOG_DB_PASSWORD=change-me
CATALOG_AUTH_ISSUER=novacommerce-auth
CATALOG_AUTH_AUDIENCE=novacommerce-api
CATALOG_AUTH_JWKS_URI=http://localhost:8081/api/v1/auth/jwks
CATALOG_ALLOWED_ORIGINS=http://localhost:3000
CATALOG_CACHE_PRODUCT_TTL=PT10M
CATALOG_REDIS_HOST=localhost
CATALOG_REDIS_PORT=6379

# Inventory service database and reservation policy
INVENTORY_DB_URL=jdbc:postgresql://localhost:5432/novacommerce_inventory
INVENTORY_DB_USERNAME=novacommerce
INVENTORY_DB_PASSWORD=change-me
INVENTORY_AUTH_ISSUER=novacommerce-auth
INVENTORY_AUTH_AUDIENCE=novacommerce-api
INVENTORY_AUTH_JWKS_URI=http://localhost:8081/api/v1/auth/jwks
INVENTORY_ALLOWED_ORIGINS=http://localhost:3000
INVENTORY_RESERVATION_TTL=PT15M
INVENTORY_EXPIRATION_SCAN_INTERVAL=PT30S
INVENTORY_EXPIRATION_BATCH_SIZE=100

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

NEXT_PUBLIC_AUTH_API_URL=http://localhost:8081

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CATALOG_API_URL=http://localhost:8082
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8083
